.easyoutline-root {
    padding-left: 2px;
    padding-right: 2px;
    padding-bottom: 6px;
}

.easyoutline-section {
    margin-top: 8px;
}

.easyoutline-section-title {
    -unity-font-style: bold;
    margin-bottom: 4px;
    padding-bottom: 3px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(128, 128, 128, 0.25);
}

.easyoutline-slider-row {
    flex-direction: row;
    align-items: center;
}

.easyoutline-slider {
    flex-grow: 1;
}

.easyoutline-value {
    min-width: 42px;
    margin-left: 5px;
    -unity-text-align: middle-right;
}

.easyoutline-renderer-count {
    margin-top: 4px;
}

.easyoutline-renderer-foldout {
    margin-top: 3px;
}

.easyoutline-renderer-list {
    margin-left: 12px;
}

.easyoutline-renderer-name {
    margin-top: 1px;
}

.easyoutline-hint {
    margin-top: 4px;
}

.easyoutline-action {
    align-self: flex-start;
    margin-top: 5px;
}

.hidden {
    display: none;
}
