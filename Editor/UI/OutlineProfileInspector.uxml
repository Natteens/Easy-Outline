<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="OutlineInspector.uss" />
    <ui:VisualElement name="root" class="easyoutline-root">
        <ui:HelpBox name="integrationHint" message-type="Warning" class="easyoutline-hint" />
        <ui:Button name="repairLayerButton" text="Repair Rendering Layer" class="easyoutline-action" />

        <ui:VisualElement class="easyoutline-section">
            <ui:Label text="Selection" class="easyoutline-section-title" />
            <uie:PropertyField binding-path="_selectionMode" label="Mode" />
            <uie:PropertyField name="layerMaskField" binding-path="_layerMask" label="Layers" />
        </ui:VisualElement>

        <ui:VisualElement class="easyoutline-section">
            <ui:Label text="Outline" class="easyoutline-section-title" />
            <ui:Toggle name="enabledField" binding-path="_enabled" label="Enabled" />
            <ui:VisualElement class="easyoutline-slider-row">
                <ui:SliderInt name="thicknessField" binding-path="_thickness" label="Thickness" low-value="1" high-value="8" class="easyoutline-slider" />
                <ui:Label name="thicknessValue" text="2 px" class="easyoutline-value" />
            </ui:VisualElement>
            <uie:PropertyField name="colorModeField" binding-path="_colorMode" label="Color Mode" />
            <uie:ColorField name="fixedColorField" binding-path="_color" label="Color" show-alpha="false" />
            <uie:PropertyField name="adaptiveDarkenField" binding-path="_adaptiveDarken" label="Darken" />
            <ui:VisualElement class="easyoutline-slider-row">
                <ui:Slider name="opacityField" binding-path="_opacity" label="Opacity" low-value="0" high-value="1" class="easyoutline-slider" />
                <ui:Label name="opacityValue" text="1.00" class="easyoutline-value" />
            </ui:VisualElement>
        </ui:VisualElement>

        <ui:VisualElement class="easyoutline-section">
            <ui:Label text="Occlusion" class="easyoutline-section-title" />
            <ui:Toggle name="occlusionEdgesField" binding-path="_outlineOcclusionEdges" label="Outline Occlusion Edges" tooltip="Draws outline along boundaries created when foreground geometry occludes the target." />
        </ui:VisualElement>

        <ui:VisualElement class="easyoutline-section">
            <ui:Label text="Cameras" class="easyoutline-section-title" />
            <ui:Toggle binding-path="_renderGameCameras" label="Game View" />
            <ui:Toggle binding-path="_renderSceneView" label="Scene View" />
            <ui:Toggle binding-path="_renderOverlayCameras" label="Overlay Cameras" />
        </ui:VisualElement>

        <ui:VisualElement class="easyoutline-section">
            <ui:Label text="Debug" class="easyoutline-section-title" />
            <uie:PropertyField binding-path="_debugMode" label="View" />
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
