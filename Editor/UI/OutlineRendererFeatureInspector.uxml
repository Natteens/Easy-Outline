<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="OutlineInspector.uss" />
    <ui:VisualElement name="root" class="outline-inspector">
        <uie:PropertyField binding-path="_profile" label="Profile" />
        <ui:HelpBox name="statusBox" class="outline-status" />
        <ui:Button name="setupButton" text="Setup / Repair" class="outline-action" />
    </ui:VisualElement>
</ui:UXML>
