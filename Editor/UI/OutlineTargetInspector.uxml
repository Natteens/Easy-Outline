<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements">
    <ui:Style src="OutlineInspector.uss" />
    <ui:VisualElement name="root" class="easyoutline-root">
        <ui:Toggle binding-path="_outlined" label="Outlined" />

        <ui:VisualElement class="easyoutline-section">
            <ui:Label text="Renderers" class="easyoutline-section-title" />
            <ui:Toggle name="autoCollectField" binding-path="_autoCollect" label="Auto Collect" />
            <ui:Toggle name="includeChildrenField" binding-path="_includeChildren" label="Include Children" />
            <ui:Label name="rendererCount" text="0 renderers resolved" class="easyoutline-renderer-count" />
            <ui:Foldout name="resolvedRendererFoldout" text="Resolved Renderers" value="false" class="easyoutline-renderer-foldout">
                <ui:VisualElement name="rendererList" class="easyoutline-renderer-list" />
            </ui:Foldout>
            <ui:HelpBox name="rendererWarning" text="No Renderer was found for this OutlineTarget." message-type="Warning" class="easyoutline-hint" />
            <ui:Button name="refreshButton" text="Refresh Renderers" class="easyoutline-action" />
            <ui:Foldout name="manualRendererFoldout" text="Manual Renderer References" value="false" class="easyoutline-renderer-foldout">
                <uie:PropertyField binding-path="_renderers" label="Renderers" />
            </ui:Foldout>
        </ui:VisualElement>

        <ui:VisualElement class="easyoutline-section">
            <ui:Label text="Appearance" class="easyoutline-section-title" />
            <ui:Toggle name="colorOverrideField" binding-path="_colorOverride" label="Override Color" />
            <uie:ColorField name="colorField" binding-path="_color" label="Color" show-alpha="false" />
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
